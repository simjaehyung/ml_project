# 이 파일을 복사해서 .env 로 만들고 실제 키를 넣으세요.
#   (.env 는 .gitignore 로 막혀 있어 키가 GitHub에 노출되지 않습니다)
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   그다음 .env 의 ANTHROPIC_API_KEY= 뒤에 sk-ant-... 붙여넣기
#
# llm_sim/run_simulation.py 가 실행 시 .env 를 자동으로 읽어 환경변수로 올립니다.

ANTHROPIC_API_KEY=sk-ant-여기에-실제-키
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
